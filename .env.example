# ==========================================
# DevPulse Dashboard Environment Variables
# ==========================================

# Application
NEXT_PUBLIC_APP_NAME="DevPulse Engineering Workspace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# AI Copilot Configuration (Optional for Cloud LLM integration)
OPENAI_API_KEY="your_openai_api_key_here"
AI_MODEL_NAME="gpt-4o"

# CI/CD Webhooks (Optional)
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# Telemetry & Monitoring (Optional)
NEXT_PUBLIC_ENABLE_TELEMETRY="false"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.example.com"
